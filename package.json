{
  "name": "obsidian-autolinks",
  "version": "1.1.0",
  "description": "Auto-convert regex patterns to clickable links",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun test"
  },
  "dependencies": {
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@lezer/common": "^1.2.3",
    "obsidian": "latest"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "@types/node": "^16.11.6",
    "esbuild": "0.25.5",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "tslib": "2.4.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@codemirror/state": "^6.5.0"
  }
}
